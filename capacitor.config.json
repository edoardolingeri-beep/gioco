{
  "appId": "com.gioco.villaggio",
  "appName": "Villaggio",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#16210f",
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#16210f",
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#16210fff",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
